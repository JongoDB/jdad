#!/usr/bin/env bash
# Local and CI proof for this repo: lint, tests, build, and plugin validate when present.
set -euo pipefail

cd "$(dirname "$0")"

echo "==> bash -n deploy scripts"
for script in deploy/common.sh deploy/install.sh deploy/update.sh deploy/update-docker.sh deploy/migrate-token.sh; do
  bash -n "$script"
done

echo "==> uv.lock is current"
# Before any `uv run`, which would silently relock and hide drift.
uv lock --check

echo "==> versions agree"
uv run --frozen python tests/check_versions.py

echo "==> deploy invocation and token parsing"
bash tests/test_deploy_invocation.sh

echo "==> token file migration"
bash tests/test_migrate_token.sh

echo "==> git checkout detection (clone and worktree)"
bash tests/test_git_checkout.sh

echo "==> docker image"
bash tests/test_docker.sh

echo "==> ruff"
uv run --frozen ruff check src tests

echo "==> pytest"
uv run --frozen pytest

echo "==> uv build"
uv build

if command -v claude >/dev/null 2>&1; then
  echo "==> claude plugin validate"
  claude plugin validate .
elif [[ -n "${CI:-}" ]]; then
  # CI must not pass with the plugin unchecked; the workflow installs the CLI.
  echo "==> claude plugin validate: FAILED (claude CLI not found and CI is set)" >&2
  exit 1
else
  echo "==> claude plugin validate: skipped (claude CLI not found on this machine; run it where the CLI is installed before merging)"
fi

echo "verify: ok"
