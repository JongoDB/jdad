#!/usr/bin/env bash
# Local and CI proof for this repo: lint, tests, build, and plugin validate when present.
set -euo pipefail

cd "$(dirname "$0")"

# --fast: ruff and pytest only (the Claude Code Stop hook runs this; see
# AGENTS.md R-flow-8). The full run stays the proof for a PR.
if [[ "${1:-}" == "--fast" ]]; then
  echo "==> ruff"
  uv run --frozen ruff check src tests .claude/hooks
  echo "==> pytest"
  uv run --frozen pytest -q
  echo "verify --fast: ok"
  exit 0
elif [[ $# -gt 0 ]]; then
  echo "usage: ./verify [--fast]" >&2
  exit 2
fi

echo "==> bash -n deploy scripts"
for script in deploy/common.sh deploy/install.sh deploy/update.sh deploy/update-docker.sh deploy/firewall-cloudflare.sh deploy/migrate-token.sh; do
  bash -n "$script"
done

echo "==> uv.lock is current"
# Before any `uv run`, which would silently relock and hide drift.
uv lock --check

echo "==> versions agree"
uv run --frozen python tests/check_versions.py

echo "==> skills catalog (spec validator, then the reference validator)"
uv run --frozen python -m jdad.catalog validate
for skill in catalog/skills/*/; do
  uv run --frozen agentskills validate "$skill"
done

echo "==> deploy invocation and token parsing"
bash tests/test_deploy_invocation.sh

echo "==> token file migration"
bash tests/test_migrate_token.sh

echo "==> git checkout detection (clone and worktree)"
bash tests/test_git_checkout.sh

echo "==> origin firewall script"
bash tests/test_firewall.sh

echo "==> docker image"
bash tests/test_docker.sh

echo "==> kb content lint"
uv run --frozen jdad lint-kb

echo "==> ruff"
uv run --frozen ruff check src tests .claude/hooks

echo "==> pytest"
uv run --frozen pytest

echo "==> uv build"
uv build

if command -v claude >/dev/null 2>&1; then
  echo "==> claude plugin validate"
  claude plugin validate .
elif [[ -n "${CI:-}" ]]; then
  # CI must not pass with the plugin unchecked; the workflow installs the CLI.
  echo "==> claude plugin validate: FAILED (claude CLI not found and CI is set)" >&2
  exit 1
else
  echo "==> claude plugin validate: skipped (claude CLI not found on this machine; run it where the CLI is installed before merging)"
fi

echo "verify: ok"
