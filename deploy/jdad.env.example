# Copy to /etc/jdad.env (mode 0600) and fill in. The systemd unit
# reads this file via EnvironmentFile=-/etc/jdad.env
#
# Optional. When set, every path except /healthz requires
# Authorization: Bearer <value>
JDAD_TOKEN=

# Comma-separated public hostnames accepted in the Host (and Origin)
# header. Loopback (127.0.0.1, localhost, ::1) is always allowed.
# DNS-rebinding protection stays on. Required when a Cloudflare Tunnel
# forwards the public hostname (e.g. jdad.example) unless you instead
# set cloudflared originRequest.httpHostHeader to a loopback host.
# JDAD_ALLOWED_HOSTS=jdad.example
JDAD_ALLOWED_HOSTS=
