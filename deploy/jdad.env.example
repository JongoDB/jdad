# For the droplet Docker deploy, copy to ~/.config/jdad/jdad.env
# (mode 0600). Generate the token into this file; never echo it.
# Never commit the filled file.
#
#   umask 077
#   mkdir -p ~/.config/jdad
#   {
#     printf 'JDAD_TOKEN='
#     openssl rand -hex 32
#     printf 'JDAD_ALLOWED_HOSTS=jdad-mcp.jondevs.com\n'
#   } > ~/.config/jdad/jdad.env
#   chmod 600 ~/.config/jdad/jdad.env
#
# To rotate: write a new token the same way, run ./deploy/update-docker.sh,
# then update every client. The previous token stops working immediately.
#
# Required for the Docker bind on 0.0.0.0. Every path except /healthz
# requires Authorization: Bearer <value>. A value that is empty or just
# quotes is treated as unset, and the process will refuse to start.
JDAD_TOKEN=

# Public hostname accepted in the Host (and Origin) header. Loopback is
# always allowed. DNS-rebinding protection stays on. docker-compose.yml
# also sets this; keep them in agreement.
JDAD_ALLOWED_HOSTS=jdad-mcp.jondevs.com
