# For the droplet Docker deploy, copy to ~/.config/jdad/jdad.env (mode 0600).
# Never commit the filled file.
#
# The bearer token does NOT go here. It lives in its own file,
# ~/.config/jdad/token (mode 0400), which compose mounts as a secret so the
# value never appears in `docker inspect`:
#
#   umask 077
#   mkdir -p ~/.config/jdad
#   openssl rand -hex 32 > ~/.config/jdad/token   # never echo it
#   chmod 400 ~/.config/jdad/token
#
# Older deploys kept JDAD_TOKEN in this file: run ./deploy/migrate-token.sh
# once. update-docker.sh refuses to run while this file sets JDAD_TOKEN, and
# the server refuses to start with both JDAD_TOKEN and JDAD_TOKEN_FILE.
#
# To rotate: write a new token over ~/.config/jdad/token, restart the
# container (or run ./deploy/update-docker.sh), then update every client.
# The previous token stops working at the restart.
#
# (The legacy systemd layout still reads JDAD_TOKEN from /etc/jdad.env.)

# Public hostname accepted in the Host (and Origin) header. Loopback is
# always allowed. DNS-rebinding protection stays on. docker-compose.yml
# also sets this; keep them in agreement.
JDAD_ALLOWED_HOSTS=jdad-mcp.jondevs.com
