# For the droplet Docker deploy, copy to ~/.config/jdad/jdad.env
# (mode 0600) and fill in JDAD_TOKEN. Never commit the filled file.
#
# The systemd path /etc/jdad.env is only used by deploy/install.sh,
# which is not how the droplet is run.
#
# Required for the Docker bind on 0.0.0.0. Every path except /healthz
# requires Authorization: Bearer <value>.
JDAD_TOKEN=

# Comma-separated public hostnames accepted in the Host (and Origin)
# header. Loopback is always allowed. DNS-rebinding protection stays on.
# docker-compose.yml also sets this; keep them in agreement.
JDAD_ALLOWED_HOSTS=jdad-mcp.jondevs.com
