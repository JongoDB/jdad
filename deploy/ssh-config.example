# SSH config for the jdad system user. sudo -u jdad has no SSH agent,
# so point Host github.com at an absolute IdentityFile and set
# IdentitiesOnly yes. Install the private deploy key at
# /var/lib/jdad/.ssh/id_ed25519 (mode 0600); this directory must be 0700.
Host github.com
  HostName github.com
  User git
  IdentityFile /var/lib/jdad/.ssh/id_ed25519
  IdentitiesOnly yes
