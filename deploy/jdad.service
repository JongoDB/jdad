[Unit]
Description=JDAD MCP server (Jon-does-agentic-dev)
Documentation=https://github.com/JongoDB/jdad
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=jdad
Group=jdad
WorkingDirectory=/opt/jdad
Environment=KB_ROOT=/opt/jdad
Environment=UV_PYTHON_PREFERENCE=only-system
EnvironmentFile=-/etc/jdad.env
# Binary lives in the checkout venv, never under /root or /home.
ExecStart=/opt/jdad/.venv/bin/jdad-mcp --http --host 0.0.0.0 --port 8765
Restart=on-failure
RestartSec=5

# Dedicated unprivileged user, plus a tight sandbox. The service needs
# JDAD_TOKEN in /etc/jdad.env; without it this bind is refused at start.
# The process is read-only against the checkout (git --no-optional-locks).
# uv sync runs from update.sh / install.sh as user jdad, outside this unit.
NoNewPrivileges=true
ProtectSystem=strict
ReadOnlyPaths=/opt/jdad
PrivateTmp=true
ProtectHome=true

StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
